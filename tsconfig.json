{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "types": ["node"],
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
     "noEmit": true
  },
      "include": ["src/**/*.ts", "playwright.config.ts"],
    "exclude": ["node_modules"] ,
    "tests": ["tests/*.ts"]
}